// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  password      String?
  role          String    @default("user") // "admin" or "user"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  companyId     String?
  company       Company?  @relation(fields: [companyId], references: [id])
  devices       Device[]
  accounts      Account[]
  sessions      Session[]
}

// Perfil tarifario del cliente. Categoria, nivel de tension y exencion NO son
// atributos del cuadro tarifario: son de QUIEN consume. Air-e publica un CU;
// que se le aplique o no la contribucion depende de esta ficha.
model Company {
  id                 String   @id @default(cuid())
  name               String
  nit                String?
  // Deben coincidir con los de Tariff para resolver la tarifa aplicable.
  provider           String   @default("Air-e")
  market             String   @default("Magdalena")
  category           String   @default("Comercial")
  voltageLevel       String   @default("NT1")
  // Usuarios comerciales e industriales NO exentos pagan contribucion.
  exemptContribution Boolean  @default(false)
  users              User[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Cuadro tarifario publicado por el comercializador, con su vigencia.
// Se guarda el CU base y la tasa de contribucion por separado, NUNCA el valor
// final: ese es derivado (CU * (1 + tasa)) y depende de la exencion del
// cliente. Guardar los tres invita a que queden inconsistentes entre si.
model Tariff {
  id               String    @id @default(cuid())
  provider         String
  market           String
  category         String
  voltageLevel     String
  baseCuCopKwh     Decimal   @db.Decimal(12, 2)
  contributionRate Decimal   @db.Decimal(5, 4)
  validFrom        DateTime
  validUntil       DateTime?
  source           String
  // Marca los valores de desarrollo que NO deben presentarse como dato oficial.
  provisional      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([provider, market, category, voltageLevel, validFrom])
}

model Device {
  id           String        @id @default(cuid())
  name         String
  type         String        // "HVAC", "Electrodoméstico", etc.
  location     String?
  status       String        @default("offline") // "online", "offline"
  serialNumber String?       @unique
  apiToken     String?       @unique // For IoT authentication
  nominalVoltage Int         @default(120) // 120 (NA/CO) or 230 (EU); used for apparent-power calc on current-only sensors
  userId       String?
  user         User?         @relation(fields: [userId], references: [id])
  // consumptions Consumption[]  <-- Removed: Now using InfluxDB
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Removed Consumption Model
// model Consumption { ... }

// NextAuth Adapter Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
